# Single source of truth for the target Postgres. Read by docker-compose.yml and faults/oom.py.
# Local dev credentials only. Host port is 5433 because a native Postgres owns 5432 on this machine.
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind
POSTGRES_DB=opsmind
POSTGRES_HOST_PORT=5433
APP_HOST_PORT=5050
